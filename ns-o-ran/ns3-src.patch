+// XAPP PATCH (E2): RC Handover_Control routed through the LTE anchor RRC
+//   target = LTE anchor cell     : move the UE data path to LTE (frequency evasion)
+//   target = NR cell, UE on LTE  : return the UE data path to NR
+//   target = NR cell, UE on NR   : secondary-cell handover (same path as the control file)
+static GlobalValue g_e2HoViaAnchor ("e2HoViaAnchor",
+                                    "XAPP PATCH: route E2 RC handover commands through the LTE anchor RRC",
+                                    BooleanValue (false), MakeBooleanChecker ());
+
+static bool
+XappE2HoViaAnchor ()
+{
+  static int cached = -1;
+  if (cached < 0)
+    {
+      BooleanValue v;
+      g_e2HoViaAnchor.GetValue (v);
+      cached = v.Get () ? 1 : 0;
+    }
+  return cached == 1;
+}
+
+static void
+XappE2Ho (uint64_t imsi, uint16_t targetCellId)
+{
+  static Ptr<LteEnbRrc> rrc;
+  static uint16_t lteCell = 0;
+  for (NodeList::Iterator it = NodeList::Begin (); it != NodeList::End () && !rrc; ++it)
+    {
+      for (uint32_t i = 0; i < (*it)->GetNDevices (); ++i)
+        {
+          Ptr<LteEnbNetDevice> dev = DynamicCast<LteEnbNetDevice> ((*it)->GetDevice (i));
+          if (dev)
+            {
+              rrc = dev->GetRrc ();
+              lteCell = dev->GetCellId ();
+              break;
+            }
+        }
+    }
+  if (!rrc)
+    {
+      std::cout << "xApp E2: LTE anchor RRC not found" << std::endl;
+      return;
+    }
+  double const t = Simulator::Now ().GetSeconds ();
+  if (targetCellId == lteCell)
+    {
+      std::cout << t << " s xApp E2: UE " << imsi << " -> LTE anchor (cell " << lteCell << ")" << std::endl;
+      rrc->TakeUeHoControl (imsi);
+      rrc->ForceConnectionSwitch (imsi, false);
+    }
+  else if (rrc->XappIsUsingLte (imsi))
+    {
+      std::cout << t << " s xApp E2: UE " << imsi << " LTE -> NR (cell " << rrc->XappLastMmWaveCell (imsi) << ")" << std::endl;
+      rrc->ForceConnectionSwitch (imsi, true);
+    }
+  else if (rrc->XappLastMmWaveCell (imsi) != targetCellId)
+    {
+      std::cout << t << " s xApp E2: UE " << imsi << " NR handover " << rrc->XappLastMmWaveCell (imsi)
+                       << " -> " << targetCellId << std::endl;
+      rrc->TakeUeHoControl (imsi);
+      rrc->PerformHandoverToTargetCell (imsi, targetCellId);
+      Simulator::Schedule (MilliSeconds (500), &LteEnbRrc::XappReleaseControl, rrc, imsi);
+    }
+}
+
+/* public entry for the in-sim JamGuard (same path as the E2 RC handler) */
+void
+MmWaveEnbNetDevice::JglHo (uint64_t imsi, uint16_t targetCellId)
+{
+  XappE2Ho (imsi, targetCellId);
+}
+
+/* JamGuard: log of RIC control messages (E2 thread: wall clock only; sim thread: sim time) */
+static std::mutex g_jgE2Mtx;
+static std::ofstream g_jgE2Log;
+static void
+JglE2Log (const char *side, double simS, int style, long action, int cell, unsigned long long value)
+{
+  std::lock_guard<std::mutex> lk (g_jgE2Mtx);
+  if (!g_jgE2Log.is_open ())
+    {
+      g_jgE2Log.open ("e2_ctrl_rx.csv", std::ios_base::out | std::ios_base::trunc);
+      g_jgE2Log << "side,wall_us,sim_s,style,action,cell,value" << std::endl;
+    }
+  long long us = std::chrono::duration_cast<std::chrono::microseconds> (
+                     std::chrono::system_clock::now ().time_since_epoch ()).count ();
+  g_jgE2Log << side << "," << us << "," << simS << "," << style << "," << action << "," << cell << ","
+            << value << std::endl;
+}
+
+/* JamGuard: apply a style-2 action inside the simulator thread */
+static void
+JglRraApply (int action, uint16_t cell, uint32_t rest)
+{
+  if (action == 6)
+    {
+      uint32_t slice = rest / 10000;
+      double q = (rest % 10000) / 1000.0;
+      if (cell == 0)
+        SliceRegistry::Instance ().SetSliceMaxRatio (slice, q);
+      else
+        SliceRegistry::Instance ().SetCellSliceMaxRatio (cell, slice, q);
+      std::cout << Simulator::Now ().GetSeconds () << " s xApp E2: RC slice quota cell " << cell << " slice "
+                << slice << " max ratio " << q << std::endl;
+    }
+  else if (action == 100)
+    {
+      int cap = (int) rest - 1;
+      SliceRegistry::Instance ().SetCellMcsCap (cell, cap);
+      std::cout << Simulator::Now ().GetSeconds () << " s xApp E2: RC MCS cap cell " << cell << " -> " << cap
+                << std::endl;
+    }
+  else
+    std::cout << "xApp E2: RC style 2 action " << action << " not supported" << std::endl;
+  JglE2Log ("apply", Simulator::Now ().GetSeconds (), 2, action, cell, rest);
+}
+
+/* JamGuard: handover applied (sim time) */
+static void
+JglHoMark (uint64_t imsi, uint16_t target)
+{
+  JglE2Log ("apply", Simulator::Now ().GetSeconds (), 3, 1, target, imsi);
+}
