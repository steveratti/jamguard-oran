+void
+LteEnbRrc::ForceConnectionSwitch (uint64_t imsi, bool useMmWave)
+{
+  // XAPP PATCH: same switch as the RAN's outage handling, triggered by an external controller
+  if (m_mmWaveCellSetupCompleted.find (imsi) == m_mmWaveCellSetupCompleted.end ())
+    {
+      std::cout << "xApp switch ignored: UE " << imsi << " not associated yet" << std::endl;
+      return;
+    }
+  if (m_imsiUsingLte[imsi] != !useMmWave)
+    {
+      Ptr<UeManager> ueMan = GetUeManager (GetRntiFromImsi (imsi));
+      m_imsiUsingLte[imsi] = !useMmWave;
+      ueMan->SendRrcConnectionSwitch (useMmWave);
+      HandoverEventMap::iterator ev = m_imsiHandoverEventsMap.find (imsi);
+      if (ev != m_imsiHandoverEventsMap.end ())
+        {
+          ev->second.scheduledHandoverEvent.Cancel ();
+          m_imsiHandoverEventsMap.erase (ev);
+        }
+      std::cout << Simulator::Now ().GetSeconds () << " s xApp: UE " << imsi << " data path to "
+                                                      << (useMmWave ? "NR" : "LTE") << std::endl;
+    }
+  if (useMmWave)
+    {
+      m_e2ControlledUes.erase (imsi); // back to the RAN's own mobility management
+    }
+}
