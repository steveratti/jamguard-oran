   // L3neighSINR_cell_XX
   ueVal->AddItem<Ptr<L3RrcMeasurements>> ("HO.TrgtCellQual.RS-SINR.UEID", l3RrcMeasurementNeigh);
 
+  auto jgIt = g_jgUeExtra.find (ueImsiComplete); // JGRSRP2
