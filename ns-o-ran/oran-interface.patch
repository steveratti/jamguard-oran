+          ueVal->AddItem<long> ("TBErrResidDl_UEID_" + ueImsiComplete, macErrResidual);
+        }
+      /* JGBLER: the same two counters, with the UE in the measurement name, so that an
+         xApp can attribute them without reading the per-UE container of the indication.
